# City Map navigation styles.

style map_description:
    font gui.interface_text_font
    size 20
    color "#d5d9ea"
    xalign 0.0

style map_card_button:
    xsize 390
    ysize 120
    background gui.glass_card
    hover_background gui.glass_btn_hover
    padding (22, 18)

style map_card_current:
    xsize 390
    ysize 120
    background gui.glass_pill
    padding (22, 18)

style map_button_text:
    font gui.interface_text_font
    size 22
    bold True
    color "#ffffff"
    xalign 0.0

style map_subtext:
    font gui.interface_text_font
    size 17
    color "#c9cfe3"
    xalign 0.0

style map_subtext_current:
    font gui.interface_text_font
    size 17
    bold True
    color "#ffe8a3"
    xalign 0.0
