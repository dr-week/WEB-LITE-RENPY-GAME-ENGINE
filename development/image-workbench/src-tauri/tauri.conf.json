{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LOLA Image Workbench",
  "version": "0.1.0",
  "identifier": "com.lolaland.imageworkbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LOLA Image Workbench",
        "width": 1380,
        "height": 920,
        "minWidth": 1050,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1422 ws://127.0.0.1:1422; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
